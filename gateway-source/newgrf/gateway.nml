spritelayout gateway_X {
    ground { sprite: 1012; }
    building { sprite: DEFAULT(0); xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 4; zextent: 48; }
    building { sprite: DEFAULT(1); xoffset: 0; yoffset: 12; zoffset: 0; xextent: 16; yextent: 4; zextent: 48; }
}
spritelayout gateway_Y {
    ground { sprite: 1011; }
    building { sprite: DEFAULT(2); xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 4; zextent: 48; }
    building { sprite: DEFAULT(3); xoffset: 0; yoffset: 12; zoffset: 0; xextent: 16; yextent: 4; zextent: 48; }
