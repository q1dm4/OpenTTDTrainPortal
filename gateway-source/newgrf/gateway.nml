    0: gateway_group_0;
    1: gateway_group_1;
    2: gateway_group_2;
    3: gateway_group_3;
    4: gateway_group_4;
    5: gateway_group_5;
    6: gateway_group_6;
    7: gateway_group_7;
    gateway_group_0;
}
item(FEAT_STATIONS, energy_gateway, 0) {
    property {
        class: "TGWY";
        classname: string(STR_CLASS);
        name: string(STR_GATEWAY);
        disabled_platforms: bitmask(2,3,4,5,6,7,8);
        disabled_length: bitmask(2,3,4,5,6,7,8);
        tile_flags: [0,0];
        animation_info: [ANIMATION_LOOPING,8];
        animation_speed: 3;
        animation_triggers: bitmask(ANIM_TRIGGER_STAT_BUILT);
    }
    graphics {
        sprite_layouts: [gateway_X,gateway_Y];
        select_tile_type: 0;
        anim_control: 0;
        purchase: gateway_frame_0;
        gateway_animation;
    }
}
