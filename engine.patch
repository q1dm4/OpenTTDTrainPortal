+/** Restricted prototype: atomically relocate a straight consist onto a clear,
+ * same-axis destination corridor. 0 = not a gateway, 1 = wait, 2 = transferred.
+ * Physical buffers are required at both ends; realistic braking is not yet supported.
+ */
+static uint TryTeleportStraightTrain(Train *consist)
+{
+    Train *front = consist->GetMovingFront();
+    const TileIndex source = front->tile;
+    auto wait = [&](const char *reason) { if (consist->tick_counter % 8 == 0) Debug(misc, 0, "Gateway wait train {} reason {}", consist->index.base(), reason); return 1U; };
+    if (!IsTeleportGatewayTile(source) || consist->teleport_gateway_exit == source) return 0;
+    const TileIndex target = GetTeleportGatewayPartner(source, consist->owner);
+    if (target == INVALID_TILE || consist->UsingRealisticBraking() ||
+            GetRailStationAxis(source) != GetRailStationAxis(target)) return wait("layout/footprint");
+    const Axis axis = GetRailStationAxis(source);
+    const Track track = AxisToTrack(axis);
+    const TrackBits trackbits = TrackToTrackBits(track);
+    const RailType railtype = GetTileRailType(source);
+    if (front->track != trackbits || GetTileRailType(target) != railtype) return wait("layout/footprint");
+    const Direction direction = front->GetMovingDirection();
+    const int dx = (static_cast<int>(TileX(target)) - static_cast<int>(TileX(source))) * TILE_SIZE;
+    const int dy = (static_cast<int>(TileY(target)) - static_cast<int>(TileY(source))) * TILE_SIZE;
+    const int source_z = GetSlopePixelZ(front->x_pos, front->y_pos, true);
+    const int target_z = GetSlopePixelZ(front->x_pos + dx, front->y_pos + dy, true);
+    std::vector<TileIndex> old_tiles;
+    uint min_x = Map::SizeX(), min_y = Map::SizeY(), max_x = 0, max_y = 0;
+    for (Train *u = consist; u != nullptr; u = u->Next()) {
+        if (u->track != trackbits || u->GetMovingDirection() != direction ||
+                u->vehstatus.Test(VehState::Crashed) || GetTileSlope(u->tile) != SLOPE_FLAT ||
+                GetSlopePixelZ(u->x_pos, u->y_pos, true) != source_z) return wait("layout/footprint");
+        const int nx = u->x_pos + dx, ny = u->y_pos + dy;
+        if (nx < 0 || ny < 0 || nx >= static_cast<int>(Map::SizeX() * TILE_SIZE) || ny >= static_cast<int>(Map::SizeY() * TILE_SIZE)) return wait("layout/footprint");
+        const TileIndex tile = TileVirtXY(nx, ny);
+        min_x = std::min(min_x, TileX(tile)); max_x = std::max(max_x, TileX(tile));
+        min_y = std::min(min_y, TileY(tile)); max_y = std::max(max_y, TileY(tile));
+        old_tiles.push_back(u->tile);
+    }
+    // One spare tile at each end covers vehicle bodies beyond centre coordinates.
+    if (axis == Axis::X) { if (min_x == 0 || max_x + 1 >= Map::SizeX()) return wait("layout/footprint"); --min_x; ++max_x; }
+    else { if (min_y == 0 || max_y + 1 >= Map::SizeY()) return wait("layout/footprint"); --min_y; ++max_y; }
+    std::vector<TileIndex> target_tiles;
+    for (uint y = min_y; y <= max_y; ++y) for (uint x = min_x; x <= max_x; ++x) {
+        const TileIndex tile = TileXY(x, y);
+        if (!IsValidTile(tile) || GetTileOwner(tile) != consist->owner ||
+                GetTileSlope(tile) != SLOPE_FLAT || GetTileRailType(tile) != railtype ||
+                GetSlopePixelZ(x * TILE_SIZE + 8, y * TILE_SIZE + 8, true) != target_z) return wait("layout/footprint");
+        if (tile == target) {
+            if (!IsTeleportGatewayTile(tile)) return wait("layout/footprint");
+        } else if (!IsPlainRailTile(tile) || GetTrackBits(tile) != trackbits || HasSignals(tile)) return wait("layout/footprint");
+        // Reject even our own vehicles: overlapping source/destination buffers
+        // are not a supported layout in this first prototype.
+        if (HasVehicleOnTile<VehicleType::Train>(tile, [](const Train *) { return true; })) return wait("layout/footprint");
+        target_tiles.push_back(tile);
+    }
+    // Drop our forward reservation first, so it cannot be mistaken for a foreign
+    // reservation on the remote exit. Occupied source tracks remain protected.
+    FreeTrainTrackReservation(consist);
+    std::vector<TileIndex> acquired;
+    const DiagDirection exitdir = VehicleExitDir(direction, trackbits);
+    const int forward_sign = (exitdir == DiagDirection::SW || exitdir == DiagDirection::SE) ? 1 : -1;
+    const int target_front_coord = axis == Axis::X ? TileX(target) : TileY(target);
+    for (TileIndex tile : target_tiles) {
+        const int coord = axis == Axis::X ? TileX(tile) : TileY(tile);
+        if ((coord - target_front_coord) * forward_sign > 0) {
+            // The leading body margin must be free, but do not pre-reserve it:
+            // that could merge our temporary footprint with someone else's path.
+            if (GetReservedTrackbits(tile) != TRACK_BIT_NONE) {
+                for (TileIndex reserved : acquired) UnreserveRailTrack(reserved, track);
+                return wait("forward margin reservation");
+            }
+            continue;
+        }
+        if (!TryReserveRailTrack(tile, track)) {
+            for (TileIndex reserved : acquired) UnreserveRailTrack(reserved, track);
+            return wait("destination reservation");
+        }
+        acquired.push_back(tile);
+    }
+    auto shift = [&](int sx, int sy) {
+        consist->MarkDirty();
+        for (Train *u = consist; u != nullptr; u = u->Next()) {
+            u->x_pos += sx; u->y_pos += sy;
+            u->tile = TileVirtXY(u->x_pos, u->y_pos);
+            u->z_pos = GetSlopePixelZ(u->x_pos, u->y_pos, true);
+            u->UpdatePosition();
+            u->UpdateInclination(true, false, false);
+        }
+        consist->MarkDirty();
+    };
+    const uint16_t speed = consist->cur_speed;
+    const uint8_t subspeed = consist->subspeed;
+    shift(dx, dy);
+    consist->teleport_gateway_exit = target;
+    CSegmentCostCacheBase::NotifyTrackLayoutChange();
+    consist->lookahead.reset();
+    // Native PBS must establish a safe route beyond the temporary footprint.
+    if (!TryPathReserve(consist, false, true)) {
+        // Failed native path reservation rolls back its own tentative path.
+        // Release only our explicitly acquired footprint; never walk a foreign path.
+        for (TileIndex tile : acquired) UnreserveRailTrack(tile, track);
+        shift(-dx, -dy);
+        consist->teleport_gateway_exit = INVALID_TILE;
+        CSegmentCostCacheBase::NotifyTrackLayoutChange();
+        consist->cur_speed = speed; consist->subspeed = subspeed;
+        for (TileIndex tile : old_tiles) TryReserveRailTrack(tile, track);
+        return wait("exit path reservation");
+    }
+    std::sort(old_tiles.begin(), old_tiles.end());
+    old_tiles.erase(std::unique(old_tiles.begin(), old_tiles.end()), old_tiles.end());
+    for (TileIndex tile : old_tiles) {
+        UnreserveRailTrack(tile, track);
+        UpdateSignalsOnSegment(tile, VehicleExitDir(direction, trackbits), consist->owner);
+        UpdateSignalsOnSegment(tile, ReverseDiagDir(VehicleExitDir(direction, trackbits)), consist->owner);
+        MarkTileDirtyByTile(tile);
+    }
+    // Extra buffer tiles outside the relocated consist must not retain orphan
+    // reservations. Keep only occupied tiles and the native forward route.
+    const int front_coord = axis == Axis::X ? TileX(front->tile) : TileY(front->tile);
+    for (TileIndex tile : acquired) {
+        const int coord = axis == Axis::X ? TileX(tile) : TileY(tile);
+        if ((coord - front_coord) * forward_sign <= 0 &&
